#!/usr/bin/env python3
import json
import os
import sqlite3
import sys

try:
    data = json.load(sys.stdin)
except Exception:
    print("Antigravity")
    sys.exit(0)

title = (data.get("conversation_title") or "").strip()
if title:
    print(title)
    sys.exit(0)

cid = (data.get("conversation_id") or data.get("session_id") or "").strip()
agy_home = os.path.expanduser(os.environ.get("AGY_HOME") or "~/.gemini/antigravity-cli")
db = os.path.join(agy_home, "conversation_summaries.db")
if cid and os.path.exists(db):
    con = None
    try:
        try:
            con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=1.0)
        except sqlite3.OperationalError:
            con = sqlite3.connect(db, timeout=1.0)
            con.execute("PRAGMA query_only = ON")
        row = con.execute(
            "SELECT title FROM conversation_summaries WHERE conversation_id = ?",
            (cid,),
        ).fetchone()
        if row and row[0] and row[0].strip():
            print(row[0].strip())
            sys.exit(0)
    except Exception:
        pass
    finally:
        if con is not None:
            con.close()

print("Antigravity")
